<resources>
    <style name="Base.Theme.DormPanel" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/panel_background</item>
        <item name="android:colorAccent">@color/panel_accent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.DormPanel" parent="Base.Theme.DormPanel" />

    <style name="TextAppearance.DormPanel.Eyebrow" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/panel_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DormPanel.Title" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/panel_primary_text</item>
        <item name="android:textSize">58sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DormPanel.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/panel_secondary_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.DormPanel.NavigationHint" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/navigation_hint_background</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/panel_primary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.DormPanel.EdgeHint" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/panel_secondary_text</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
