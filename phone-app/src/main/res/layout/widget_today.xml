<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:includeFontPadding="false" android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日课程" android:textColor="@color/widget_ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:includeFontPadding="false" android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本机今日课表" android:textColor="@color/widget_secondary" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:includeFontPadding="false" android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="课程仍在加载" android:textColor="@color/widget_secondary" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
</LinearLayout>
